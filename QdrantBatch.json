      "parameters": {
        "language": "pythonNative",
        "pythonCode": "output = []\n\nfor item in _items:\n    # In Native mode: check if nested or direct\n    if isinstance(item, dict) and 'json' in item:\n        d = item['json']\n    else:\n        d = item\n\n    token = d.get(\"token\", \"\")\n    symbol = d.get(\"symbol\", \"\")\n    name = d.get(\"name\", \"\")\n    exchange = d.get(\"exchange\", \"\")\n    terms = d.get(\"search_terms\", \"\")\n\n    page = f\"{symbol}, {name}, {terms}, token={token}, symbol={symbol}, name={name}, exchange={exchange}\"\n\n    output.append({\n        \"pageContent\": page\n    })\n\nreturn output\n"
      },
